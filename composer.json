{
    "name": "notakey/simplesamlphp-module-ntktheme",
    "description": "A SimpleSAMLphp Notakey branded theme.",
    "type": "simplesamlphp-module",
    "keywords": ["notakey", "simplesamlphp-theme"],
    "license": "MIT",
    "authors": [{
        "name": "Ingemars Asmanis",
        "email": "ingemars.asmanis@notakey.com"
    }],
    "require": {
        "php": "^8.3",
        "simplesamlphp/composer-module-installer": "^1.7",
        "simplesamlphp/simplesamlphp": "^2.5"
    },
    "config": {
        "allow-plugins": {
            "simplesamlphp/composer-module-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "SimpleSAML\\Module\\ntktheme\\": "src/"
        }
    }
}
