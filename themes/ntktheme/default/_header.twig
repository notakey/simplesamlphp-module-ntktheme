<nav class="navbar navbar-toggleable-md navbar-dark">
    {% if not hideLanguageBar and languageBar %}
        <div id="languagebar">
            {% for key, lang in languageBar %}
                {%- if not loop.first %} | {% endif -%}
                {% if key == currentLanguage or not lang.url %}
                    {{ lang.name }}
                {% else %}
                    <a href="{{ lang.url }}
                        {%- if queryParams %}&{% endif %}
                        {%- for name, value in queryParams %}
                            {%- if not loop.first %}&{% endif %}
                            {%- if value %}{{ name }}={{ value }}{% else %}{{ name }}{% endif %}
                        {%- endfor %}">{{ lang.name }}</a>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}

    <a class="navbar-brand mr-auto" href="/{{ baseurlpath }}">
        <img id="brandLogo" src="{{ moduleURL('ntktheme/resources/notakey-white-nobg.svg') }}" height="30" alt="Notakey">
    </a>
</nav>
